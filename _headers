# _headers — Cloudflare Pages cache control
# HTML pages: always revalidate (no stale pages in browser cache)
/*.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

/en/
  Cache-Control: no-cache, must-revalidate

/tr/
  Cache-Control: no-cache, must-revalidate

/ar/
  Cache-Control: no-cache, must-revalidate

/en/*.html
  Cache-Control: no-cache, must-revalidate

/tr/*.html
  Cache-Control: no-cache, must-revalidate

/ar/*.html
  Cache-Control: no-cache, must-revalidate

# JS and CSS: revalidate on every load (active development)
/js/*
  Cache-Control: no-cache, must-revalidate

/css/*
  Cache-Control: no-cache, must-revalidate

# Product data: short cache (5 minutes)
/products/data.json
  Cache-Control: public, max-age=300

# Images and assets: long cache (1 year — filenames don't change often)
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/logo/*
  Cache-Control: public, max-age=31536000, immutable
